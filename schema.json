{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "type",
    "lang",
    "text",
    "region",
    "source"
  ],
  "properties": {
    "type": {
      "enum": [
        "proverb",
        "charm",
        "riddle",
        "carol",
        "tale",
        "saying",
        "lullaby"
      ]
    },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2,3}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "translations": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "collector": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  }
}
